<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecc_session_card_difference_form" model="ir.ui.view">
        <field name="name">ecc.session.card.difference.form</field>
        <field name="model">ecc.session.card.difference</field>
        <field name="arch" type="xml">
            <form string="Forgotten Card Difference">
                <div class="alert alert-info" role="status">
                    A card difference the cashier did not enter at closing. Example: an order paid by card but
                    rung up as cash: the drawer is short and the card terminal got more. It is added to the
                    session's differences; classify both with the same category and they cancel out.
                </div>
                <group>
                    <group>
                        <field name="session_id"/>
                        <field name="payment_method_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="difference_type" widget="radio"/>
                        <field name="amount"/>
                        <field name="name" placeholder="e.g. Order 0042 paid by card, entered as cash"/>
                    </group>
                    <group string="Session differences">
                        <field name="cash_difference" decoration-danger="cash_difference &lt; 0"
                               decoration-success="cash_difference &gt; 0"/>
                        <label for="card_before" string="Card"/>
                        <div class="d-flex gap-2">
                            <field name="card_before" class="oe_inline"/> →
                            <field name="card_after" class="oe_inline fw-bold"/>
                        </div>
                        <field name="total_after" class="fw-bold" decoration-danger="total_after &lt; 0"
                               decoration-success="total_after &gt; 0"/>
                    </group>
                </group>
                <field name="method_ids" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Record Card Difference" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

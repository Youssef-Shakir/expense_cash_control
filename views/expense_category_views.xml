<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expense_category_list" model="ir.ui.view">
        <field name="name">expense.category.list</field>
        <field name="model">expense.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="account_id"/>
                <field name="available_in_pos" widget="boolean_toggle"/>
                <field name="pos_cash_type" invisible="not available_in_pos"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_expense_category_form" model="ir.ui.view">
        <field name="name">expense.category.form</field>
        <field name="model">expense.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="expense_count"/></span>
                                <span class="o_stat_text">Expenses</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Vegetables &amp; Produce"/></h1>
                    </div>
                    <group>
                        <group string="Accounting">
                            <field name="code" placeholder="e.g. VEG"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Point of Sale">
                            <field name="available_in_pos"/>
                            <field name="pos_cash_type" widget="radio" invisible="not available_in_pos"/>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_expense_category_search" model="ir.ui.view">
        <field name="name">expense.category.search</field>
        <field name="model">expense.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="account_id"/>
                <filter name="pos" string="Available in POS" domain="[('available_in_pos', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_expense_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">expense.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first expense category</p>
            <p>Link every category to an account. Mark it "Available in POS" to let cashiers use it for Cash In / Cash Out.</p>
        </field>
    </record>

</odoo>

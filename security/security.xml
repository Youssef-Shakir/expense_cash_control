<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_expense_cash_control" model="ir.module.category">
        <field name="name">Expenses &amp; Cash Control</field>
        <field name="description">Record expenses and control POS cash</field>
        <field name="sequence">36</field>
    </record>

    <!-- Every internal user can record expenses (as with the former Expenses Press). -->
    <record id="group_expense_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Record expenses and bills, attach receipts.</field>
        <field name="category_id" ref="module_category_expense_cash_control"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_expense_user'))]"/>
    </record>

    <record id="group_expense_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Classify POS cash in/out and cash differences, review closed sessions, manage categories.</field>
        <field name="category_id" ref="module_category_expense_cash_control"/>
        <field name="implied_ids" eval="[(4, ref('group_expense_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_expense_manager'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_expense_express_company" model="ir.rule">
        <field name="name">Expense: multi-company</field>
        <field name="model_id" ref="model_expense_express"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_expense_category_company" model="ir.rule">
        <field name="name">Expense category: multi-company</field>
        <field name="model_id" ref="model_expense_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_cash_difference_company" model="ir.rule">
        <field name="name">Cash difference: multi-company</field>
        <field name="model_id" ref="model_cash_difference_reconciliation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pos_cash_move_company" model="ir.rule">
        <field name="name">POS cash move: multi-company</field>
        <field name="model_id" ref="model_pos_cash_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

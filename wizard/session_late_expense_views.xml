<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecc_session_late_expense_form" model="ir.ui.view">
        <field name="name">ecc.session.late.expense.form</field>
        <field name="model">ecc.session.late.expense</field>
        <field name="arch" type="xml">
            <form string="Forgotten Expense">
                <div class="alert alert-info" role="status">
                    A cash-out paid from the drawer during the session that the cashier forgot to record.
                    The counted cash stays the same; the expected cash goes down and the cash difference
                    is posted again.
                </div>
                <group>
                    <group>
                        <field name="session_id"/>
                        <field name="name" placeholder="e.g. Vegetables - Abu Ali"/>
                        <field name="amount"/>
                        <field name="category_id" options="{'no_create': True}"
                               placeholder="Classify later..."/>
                    </group>
                    <group string="Session cash">
                        <field name="counted"/>
                        <label for="expected_before" string="Expected"/>
                        <div class="d-flex gap-2">
                            <field name="expected_before" class="oe_inline"/> →
                            <field name="expected_after" class="oe_inline fw-bold"/>
                        </div>
                        <label for="difference_before" string="Difference"/>
                        <div class="d-flex gap-2">
                            <field name="difference_before" class="oe_inline"/> →
                            <field name="difference_after" class="oe_inline fw-bold"
                                   decoration-danger="difference_after &lt; 0"
                                   decoration-success="difference_after &gt; 0"/>
                        </div>
                    </group>
                </group>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Record Expense" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
